# ─── Universe — Environment Variable Template ──────────────────────────────
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
#
# Never commit the populated .env file. It is in .gitignore.
# Generate strong secrets with: openssl rand -hex 32
# ───────────────────────────────────────────────────────────────────────────


# ─── Required: core runtime ─────────────────────────────────────────────────

# 'production' for live deployments, 'development' for local dev, 'test' for CI.
NODE_ENV=production

# Port the Express server listens on. Nginx/Docker should proxy to this.
PORT=4000

# Postgres connection string. URL-encode special characters in the password
# (e.g. '@' becomes '%40', '#' becomes '%23').
# Same-box: postgresql://universe:PASSWORD@localhost:5432/universe
# Remote:   postgresql://universe:PASSWORD@db.internal:5432/universe?sslmode=require
DATABASE_URL=postgresql://universe:CHANGE_ME@localhost:5432/universe

# Apply pending DB migrations on every server boot. Recommended: false
# for production: run migrations as an explicit pre-deploy step so a bad
# migration fails the deploy before the API process starts. docker-compose.yml
# sets this to true for local development convenience.
RUN_MIGRATIONS_ON_BOOT=false

# Allowed CORS origin. In production set to the public URL. Comma-separated
# for multiple. NEVER set to '*' in production — the API trusts a header for
# role auth, so an open CORS policy expands the attack surface significantly.
CORS_ORIGIN=https://universe.internal.company.com

# Session secret. Must be at least 64 random hex characters in production.
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32

# Session lifetime in hours. 8 = a working day. Underwriters re-login next morning.
SESSION_TTL_HOURS=8


# ─── Optional: file storage ─────────────────────────────────────────────────

# Local directory for uploaded slips and documents. Defaults to ./uploads
# relative to the project root. Override only if a different mount is needed.
# UPLOAD_DIR=/var/lib/universe/uploads

# If using Cloudinary instead of local disk for uploads, set all three.
# Leave blank to use local storage.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=


# ─── Optional: AI features ──────────────────────────────────────────────────

# Used by the treaty-slip ingestion feature. Without this, the slip-ingest
# button in the UI will fail at runtime — disable it in the UI or accept
# that users will see an error if they try it.
OPENAI_API_KEY=

# Anthropic and Gemini are not currently used by primary flows but several
# helper endpoints will fall back to them if set. Optional.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ─── Optional: database tuning ──────────────────────────────────────────────

# Connection pool size per Node process. Default 50 is sized for ~30 users
# on a single Node process. If running PM2 cluster mode, ensure
# (DB_POOL_MAX × number of processes) stays well under the Postgres
# max_connections limit (default 100).
# DB_POOL_MAX=50
# DB_POOL_MIN=4

# Idle and connection timeouts in milliseconds.
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=5000

# Optional secondary database for the dashboard module. Leave blank if unused.
# DASHBOARD_DATABASE_URL=


# ─── Optional: HTTP tuning ──────────────────────────────────────────────────

# Per-request timeout in milliseconds. Slightly above the DB statement timeout
# so Postgres errors surface first with useful messages.
# REQUEST_TIMEOUT_MS=35000

# TCP keep-alive timing for the Node server. Should match upstream proxy
# (Nginx, ELB, etc.) idle timeout. Default values work for Render and most
# cloud LBs.
# KEEPALIVE_TIMEOUT_MS=65000
# HEADERS_TIMEOUT_MS=66000


# ─── Optional: pricing strict mode ──────────────────────────────────────────

# When set to '1', the server rejects (HTTP 422 PRICING_DRIFT) any client-
# submitted NP pricing outputs that disagree with its own server-side
# calculation. Default is warn-only — every response carries an
# X-Pricing-Drift-Count header regardless. Leave at default until the
# parser-mismatch finding in docs/actuarial-audit.md has been resolved.
# PRICING_STRICT=0


# ─── Optional: observability ────────────────────────────────────────────────

# Set OTEL_ENABLED=1 to emit OpenTelemetry traces and metrics.
# OTEL_ENABLED=0
# OTEL_SERVICE_NAME=universe-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=0.1

# Port that the Prometheus metrics scraper hits. Default 9464.
# PROM_EXPORTER_PORT=9464


# ─── Optional: client build location ────────────────────────────────────────

# Override only if the client/dist directory is not at the default location
# (../client/dist relative to server/src/).
# CLIENT_DIST_DIR=
