# ─── Universe — Environment Variable Template ──────────────────────────────
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
#
# Never commit the populated .env file. It is in .gitignore.
# Generate strong secrets with: openssl rand -hex 32
# ───────────────────────────────────────────────────────────────────────────


# ─── Required: core runtime ─────────────────────────────────────────────────

# 'production' for live deployments, 'development' for local dev, 'test' for CI.
# Left as 'development' in the template ON PURPOSE: copying this file verbatim
# must NOT boot a production server still carrying the CHANGE_ME placeholder
# secrets below. Set this to 'production' only once you've replaced every
# CHANGE_ME value with a real generated secret.
NODE_ENV=development

# Port the Express server listens on. Nginx/Docker should proxy to this.
PORT=4000

# Postgres connection string. URL-encode special characters in the password
# (e.g. '@' becomes '%40', '#' becomes '%23').
# Same-box: postgresql://universe:PASSWORD@localhost:5432/universe
# Remote:   postgresql://universe:PASSWORD@db.internal:5432/universe?sslmode=require
DATABASE_URL=postgresql://universe:CHANGE_ME@localhost:5432/universe

# Apply pending DB migrations on every server boot. Recommended: true.
# Set false only if migrations are run manually as a deployment step.
RUN_MIGRATIONS_ON_BOOT=true

# Allowed CORS origin. In production set to the public URL. Comma-separated
# for multiple. NEVER set to '*' in production.
CORS_ORIGIN=https://universe.internal.company.com

# Auth bearer-token signing secret. REQUIRED in production — the server REFUSES
# TO BOOT without a strong value (>= 32 chars; see server/src/config/env.js).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=CHANGE_ME_RUN_NODE_RANDOMBYTES_48_BASE64URL

# Reserved for future cookie/session use. Not consumed at runtime today, so it
# does NOT block boot; if you set it, it is strength-checked (>= 32 chars).
# Generate the same way as AUTH_JWT_SECRET.
SESSION_SECRET=CHANGE_ME_RUN_NODE_RANDOMBYTES_48_BASE64URL

# Session lifetime in hours. 8 = a working day. Underwriters re-login next morning.
SESSION_TTL_HOURS=8

# Password hashing work factor — the log2 of scrypt's N parameter. Hashing is
# async (off the event loop) so raising this does NOT block the login path.
# Default 15 (N=2^15=32768); legacy rows hashed at 14 are auto-upgraded on the
# next successful login. Clamped to 14..20. Raise as hardware improves; measure
# login latency after a change (target < ~100ms server-side derivation).
# PASSWORD_SCRYPT_COST=15

# Login-screen "Add user" self-registration. OFF by default: only CU/CE roles
# can create users. Set 'true' ONLY on dev/preview environments — never in
# production (see SECURITY.md).
# ALLOW_OPEN_REGISTRATION=false

# Passwordless "name login" (client-pilot testing, e.g. Saudi Re). When 'true',
# testers sign in with just first name + surname — no password — and get a real
# cookie session (an Underwriter account is created on first use).
# Fail-closed: OFF unless exactly 'true'. Remove after the pilot.
# ALLOW_NAME_AUTH=false


# ─── File storage & upload security ─────────────────────────────────────────

# Local directory for uploaded slips and documents. Defaults to ./uploads
# relative to the project root. Override only if a different mount is needed.
# UPLOAD_DIR=/var/lib/universe/uploads

# Durable PRIVATE object storage for uploads. PRODUCTION REQUIRES THIS — without
# it, document uploads fail (503 STORAGE_NOT_DURABLE) because a web dyno's disk
# is ephemeral and per-instance. Set CLOUDINARY_URL (the SDK reads it directly)…
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# …or the three discrete vars (equivalent; the app builds the config from them):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Escape hatch: explicitly accept EPHEMERAL local-disk uploads in production
# (e.g. a single box with a persistent mounted volume). Off by default so prod
# fails closed toward durable storage. Never set this on a multi-instance deploy.
# ALLOW_LOCAL_UPLOADS=false

# Malware scanning (ClamAV). When enabled every upload is streamed to clamd
# (INSTREAM) before it is stored, FAIL-CLOSED: an infected file is rejected (422)
# and a scan that can't complete rejects the upload (503). Strongly recommended
# in production. Requires a reachable clamd (e.g. a sidecar container).
# CLAMAV_ENABLED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000


# ─── Identity / SSO / MFA (enterprise login posture) ────────────────────────
# SSO is OFF by default (local passwords). Enabling makes OIDC the login path;
# local password login is then refused (403 SSO_REQUIRED) for everyone EXCEPT the
# audited break-glass usernames. See docs/runbooks/sso-mfa-break-glass.md.

# Master switch. When 'true', IDENTITY_ISSUER/CLIENT_ID/CLIENT_SECRET/REDIRECT_URI
# become required (the server logs config errors at boot if missing).
# IDENTITY_SSO_ENABLED=false
# IDENTITY_PROVIDER=                 # free-text label only (e.g. "EntraID", "Okta")
# IDENTITY_ISSUER=https://login.example.com/
# IDENTITY_CLIENT_ID=
# IDENTITY_CLIENT_SECRET=            # confidential client secret
# IDENTITY_REDIRECT_URI=https://app.example.com/api/auth/sso/callback
# IDENTITY_POST_LOGOUT_REDIRECT_URI=https://app.example.com/
# IDENTITY_SCOPES=openid profile email

# Role mapping (D3 — least privilege): map an IdP claim value → internal role.
# New/unknown users land on IDENTITY_DEFAULT_ROLE (lowest privilege).
# IDENTITY_ROLE_CLAIM=groups
# IDENTITY_ROLE_MAP={"reinsurance-admins":"CU","reinsurance-uw":"TUW"}
# IDENTITY_DEFAULT_ROLE=TUW

# MFA enforced IN-APP (D2): the token's acr must be one of REQUIRED_ACR and ALL
# REQUIRED_AMR methods must be present — not trusting the IdP's policy alone.
# Set at least one in production so MFA is actually enforced.
# IDENTITY_REQUIRED_ACR=
# IDENTITY_REQUIRED_AMR=pwd,mfa

# Fail-closed MFA (recommended for enterprise): when set truthy, the server
# REFUSES TO BOOT unless MFA is genuinely enforced — i.e. SSO is on AND at least
# one of IDENTITY_REQUIRED_ACR/AMR is set. Opt-in; unset keeps today's tolerant
# (warn-only) behaviour.
# IDENTITY_ENFORCE_MFA=1

# Break-glass (D4): comma list of usernames allowed to use a LOCAL password while
# SSO is the default. Every such login is audited (BREAK_GLASS_LOGIN) and raises
# a security alert. Keep this list small; review it regularly.
# IDENTITY_BREAK_GLASS_USERS=root.admin


# ─── Optional: AI features ──────────────────────────────────────────────────

# Master gate for ALL AI features. ON by default in every environment,
# production included — uncomment the line below to turn AI off, and every AI
# endpoint then returns 403 AI_DISABLED regardless of which provider keys are
# configured (see server/src/lib/aiGovernance.js).
#
# With the gate open, AI calls send treaty and document content to an external
# provider as soon as a key is set below, so make sure the customer/legal
# approval and the provider's retention terms cover that. A key is still
# required: with none configured the endpoints return 403 AI_NOT_CONFIGURED.
# Per-tenant opt-out is AI_CUSTOMER_OPTOUT=true.
# AI_FEATURES_ENABLED=false

# Used by the treaty-slip ingestion feature. Without this, the slip-ingest
# button in the UI will fail at runtime — disable it in the UI or accept
# that users will see an error if they try it.
OPENAI_API_KEY=

# Anthropic and Gemini are not currently used by primary flows but several
# helper endpoints will fall back to them if set. Optional.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ─── Optional: database tuning ──────────────────────────────────────────────

# Connection pool size per Node process. Default 50 is sized for ~30 users
# on a single Node process. If running PM2 cluster mode, ensure
# (DB_POOL_MAX × number of processes) stays well under the Postgres
# max_connections limit (default 100).
# DB_POOL_MAX=50
# DB_POOL_MIN=4

# Idle and connection timeouts in milliseconds.
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=5000

# Shared store for DISTRIBUTED rate limiting across instances. When set, the IP /
# login / per-user / password limiters share counts via Redis (or Valkey) so N
# instances enforce one ceiling, not N×. When unset, each instance uses its own
# in-memory counts (fine for a single process). If Redis is unreachable the
# limiters degrade to in-memory and log "[ratelimit] degraded" (alert on it) —
# limiting is never silently lost. Required in multi-instance staging/prod.
# REDIS_URL=redis://localhost:6379


# ─── Optional: HTTP tuning ──────────────────────────────────────────────────

# Per-request timeout in milliseconds. Slightly above the DB statement timeout
# so Postgres errors surface first with useful messages.
# REQUEST_TIMEOUT_MS=35000

# TCP keep-alive timing for the Node server. Should match upstream proxy
# (Nginx, ELB, etc.) idle timeout. Default values work for Render and most
# cloud LBs.
# KEEPALIVE_TIMEOUT_MS=65000
# HEADERS_TIMEOUT_MS=66000


# ─── Optional: pricing strict mode ──────────────────────────────────────────

# When set to '1', the server rejects (HTTP 422 PRICING_DRIFT) any client-
# submitted NP pricing outputs that disagree with its own server-side
# calculation. Default is warn-only — every response carries an
# X-Pricing-Drift-Count header regardless. Leave at default until the
# parser-mismatch finding in docs/actuarial-audit.md has been resolved.
# PRICING_STRICT=0


# ─── Optional: observability ────────────────────────────────────────────────

# OpenTelemetry is ON BY DEFAULT in production/staging (NODE_ENV=production)
# and OFF in dev/test. An explicit value always wins:
#   OTEL_ENABLED=1  forces it on anywhere (use in dev to try it locally)
#   OTEL_ENABLED=0  forces it off (emergency production rollback, no redeploy)
# OTEL_ENABLED=1
# OTEL_SERVICE_NAME=universe-server
# Traces export only when this is set; metrics (Prometheus) work without it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=0.1

# Port that the Prometheus metrics scraper hits. Default 9464.
# PROM_EXPORTER_PORT=9464
# Bind host for the /metrics scrape server. Default 127.0.0.1 (loopback) so it
# is PRIVATE — not reachable off-box. Set to the pod's private IP, or 0.0.0.0
# when the platform provides network-level isolation, to allow a remote scraper.
# PROM_EXPORTER_HOST=127.0.0.1


# ─── Optional: client build location ────────────────────────────────────────

# Override only if the client/dist directory is not at the default location
# (../client/dist relative to server/src/).
# CLIENT_DIST_DIR=


# ─── Scheduled jobs / backups (used by scripts/, NOT the app runtime) ────────
# Consumed by scripts/backup-db.sh and scripts/verify-restore.sh (and the cron
# wrappers in render.yaml / scheduled-jobs.yml). Documented here for one canonical
# place; see docs/backup-recovery.md for RPO/RTO and the bucket lifecycle policy.

# Where dumps land on the job's local disk, and how long to keep LOCAL copies.
# BACKUP_DIR=/var/backups/universe
# BACKUP_RETENTION_DAYS=30

# Durable object storage (S3-compatible). Set BACKUP_S3_BUCKET to push every dump
# off the ephemeral job disk; restore-verify fetches the newest from here.
# Object-storage RETENTION is a bucket LIFECYCLE rule, not BACKUP_RETENTION_DAYS.
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=backups
# BACKUP_S3_ENDPOINT=            # only for non-AWS S3-compatible stores (MinIO/R2/Spaces/GCS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# Failure alerting: scripts/run-with-alert.sh POSTs here on a non-zero job exit.
# ALERT_WEBHOOK_URL=

# ─── Address lookup — Google Places (optional) ───────────────────────────────
# Powers the Insured Address autocomplete on the facultative risk form
# (routes/facPlaces.js → lib/googlePlaces.js). UNSET = the feature is simply
# off: /api/fac/places/status reports configured:false and the form renders a
# plain text input, so nothing breaks on a deployment without a key.
#
# This is a SERVER-side key and must never be shipped to the browser — the
# client talks to our own same-origin proxy, so the enforcing CSP in app.js
# needs no Google host added to script-src/connect-src.
#
# Enable "Places API (New)" on the Google Cloud project and restrict the key by
# API (Places only). An IP restriction is appropriate here because calls leave
# the server, NOT an HTTP-referrer restriction (that is for browser keys).
#
# BILLING: Places is charged per request. The route is capped at 60 lookups per
# minute per user on top of the global API limiter, and the client debounces and
# sends a session token so one address costs one session rather than one call
# per keystroke. Set a Google Cloud budget alert regardless.
# GOOGLE_MAPS_API_KEY=
