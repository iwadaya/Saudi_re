# server/.env.example — local server config template.
#
# Copy to server/.env (gitignored) and adjust for your machine:
#   cp server/.env.example server/.env
#
# server/.env, the repo-root .env, and the current working directory's .env are
# all loaded at startup (see server/src/config/env.js). These vars are read by
# `npm run dev|migrate:status|migrate:up --prefix server` and the test suite.
#
# Quick start (matches the bundled docker-compose `db` service):
#   docker compose up -d db          # Postgres on localhost:5432, postgres/postgres
#   npm run migrate:up --prefix server
#   npm run migrate:status --prefix server   # should list applied vs pending

# ─── Required: database ──────────────────────────────────────────────────────
# Postgres connection string. This default matches the docker-compose `db`
# service AND the built-in fallback, so a fresh `docker compose up -d db` works
# with no edits. Pointing at a host Postgres? Make sure that role's password and
# database name match (URL-encode special chars in the password, e.g. '@'->'%40').
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reinsurance_tool

# Port the API listens on. Default 4000.
PORT=4000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Bearer-token signing secret. OPTIONAL in dev/test: when unset the server mints
# a per-process ephemeral secret (tokens won't survive a restart). REQUIRED in
# production — the server refuses to boot without a strong value (>= 32 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_JWT_SECRET=

# Session/cookie secret. Reserved for cookie-session use; not consumed at runtime
# today, so it does NOT block boot. If you set it, it is strength-checked
# (>= 32 chars). Recommended in production. Generate the same way as AUTH_JWT_SECRET.
# SESSION_SECRET=

# Local/test login convenience. When 'true', enables the demo2026 password
# shortcut and x-user-* header identity that the test suite and local logins
# rely on. NEVER set this in production. (The server vitest config already sets
# ALLOW_DEMO_AUTH=true for the test run; set it here for manual local dev.)
ALLOW_DEMO_AUTH=true
