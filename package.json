{
  "name": "universe3",
  "private": true,
  "version": "3.0.0",
  "description": "Universe 3 — Reinsurance Treaty Pricing & Modelling Tool",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:screens": "eslint client/src/screens --max-warnings=0",
    "typecheck": "npm run typecheck --prefix client",
    "budget:frontend": "node scripts/frontend-budget.mjs",
    "golden:fac": "node scripts/update-fac-golden-master.mjs",
    "seed:treaties": "node server/scripts/seedTestTreaties.js",
    "seed:treaties:reset": "node server/scripts/seedTestTreaties.js --reset",
    "seed:treaties:verify": "node server/scripts/seedTestTreaties.js --verify",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run --config server/vitest.config.js",
    "test:server:coverage": "vitest run --config server/vitest.config.js --coverage",
    "test:client": "vitest run --config client/vitest.config.js",
    "test:client:coverage": "vitest run --config client/vitest.config.js --coverage",
    "test:watch": "vitest --config server/vitest.config.js",
    "loadtest": "k6 run load-test/k6/portfolio.js",
    "loadtest:10vu": "k6 run load-test/k6/smoke-10vu.js",
    "loadtest:capacity": "k6 run load-test/k6/capacity.js",
    "loadtest:summarize": "node load-test/scripts/summarize-k6.mjs",
    "start:cluster": "pm2 start ecosystem.config.cjs --no-daemon",
    "cluster:reload": "pm2 reload ecosystem.config.cjs",
    "cluster:stop": "pm2 stop ecosystem.config.cjs",
    "cluster:status": "pm2 status",
    "cluster:logs": "pm2 logs universe",
    "verify": "npm run lint && npm run typecheck && npm run budget:frontend && npm run test:server && npm run build && npm run test:client:coverage"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "overrides": {
    "pm2": {
      "ws": "^8.21.0",
      "js-yaml": "^4.3.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "concurrently": "^10.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "pm2": "^7.0.1",
    "vitest": "^4.1.6"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.1.2",
    "@rolldown/binding-darwin-x64": "1.1.2",
    "@rolldown/binding-linux-x64-gnu": "1.1.2"
  }
}
