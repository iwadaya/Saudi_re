# /etc/universe/universe.env — production environment for the Universe service.
#
# Read by BOTH systemd (EnvironmentFile= in deploy/universe.service) and by the
# app/CLI scripts via the /opt/universe/.env symlink (dotenv). Keep the format
# plain KEY=VALUE — no quotes, no `export`, no shell expansion.
#
#   sudo install -m 600 -o universe -g universe deploy/universe.env.example /etc/universe/universe.env
#   sudo -e /etc/universe/universe.env
#
# deploy/install-server.sh renders this file for you (secrets generated, DB URL
# filled in). Every CHANGE_ME value MUST be replaced: the server refuses to boot
# in production while AUTH_JWT_SECRET is a placeholder or shorter than 32 chars.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Postgres. URL-encode special characters in the password (@ → %40, # → %23,
# / → %2F, : → %3A, % → %25). deploy/provision-db.sh prints a ready-made URL.
DATABASE_URL=CHANGE_ME__postgresql://universe:PASSWORD@localhost:5432/universe

# Migrations are applied by deploy/deploy.sh BEFORE the service restarts, so a
# bad migration fails the deploy instead of taking the running app down.
RUN_MIGRATIONS_ON_BOOT=false

# Test-portfolio seeding on deploy (server/scripts/seedOnDeploy.js). Leave it
# UNSET on production: deploy.sh always seeds reference data (countries,
# currencies, brokers, reinsurers, cedants, …) and never contracts. Only a demo
# or training box sets SEED_ON_DEPLOY=1 (load the fabricated treaty portfolio
# once) or reset (reload it every deploy). See docs/seed-test-treaties.md.
# SEED_ON_DEPLOY=

# The exact public origin users type into the browser (scheme + host, no path).
# Never '*' in production.
CORS_ORIGIN=CHANGE_ME__https://universe.example.internal

# ── Secrets (>= 32 chars each). Generate: openssl rand -base64 48 | tr '+/' '-_'
AUTH_JWT_SECRET=CHANGE_ME__GENERATE_WITH_OPENSSL_RAND
SESSION_SECRET=CHANGE_ME__GENERATE_WITH_OPENSSL_RAND
SESSION_TTL_HOURS=8

# ── Uploads (single box, local disk) ────────────────────────────────────────
# Slips/documents are written here; the systemd unit grants write access to
# /var/lib/universe only. Back this directory up with the database.
UPLOAD_DIR=/var/lib/universe/uploads
# Production refuses local-disk uploads unless explicitly accepted — this is a
# single persistent server, so accept it. Remove if you move to Cloudinary.
ALLOW_LOCAL_UPLOADS=true

# ── Login posture ───────────────────────────────────────────────────────────
# Leave these UNSET/false in production. ALLOW_DEMO_AUTH would enable the
# universal demo password + header identity (the server refuses to boot with
# it in production); ALLOW_OPEN_REGISTRATION lets anyone create an account.
ALLOW_OPEN_REGISTRATION=false
# Pilot-only passwordless "name login" (first name + surname, no password).
# Fail-closed: off unless exactly 'true'. Enable only for a supervised pilot.
# ALLOW_NAME_AUTH=true

# ── AI features (slip ingest, market intelligence) ──────────────────────────
# OFF until the customer/legal sign-off for sending treaty content to an
# external provider is in place. Set to true AND add a provider key to enable.
AI_FEATURES_ENABLED=false
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Observability ───────────────────────────────────────────────────────────
# OpenTelemetry defaults ON in production; keep it off until a collector exists.
OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal:4318

# ── Tuning (defaults are right for one Node process and ~30 users) ──────────
# DB_POOL_MAX=50
# DB_POOL_MIN=4
# SHUTDOWN_GRACE_MS=10000
# PRICING_STRICT=1
